# Base44 local defaults — placeholders so the app boots without external credentials.
# Real secrets (when needed) are delivered via /run/base44/app.env and override these.

# Used by the Express server to sign session JWTs. Placeholder is fine for the
# public funnel; replace via the secrets dashboard if auth is exercised.
JWT_SECRET=base44-dev-secret-placeholder-change-me

# Frontend runs in local-preview mode (mock data) when this is empty.
# Set it to the Worker URL only when the Cloudflare backend is deployed.
VITE_API_BASE_URL=
